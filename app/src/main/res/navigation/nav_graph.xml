<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <action
        android:id="@+id/action_global_groupDetail"
        app:destination="@id/groupDetailFragment"
        app:launchSingleTop="true" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tech.spendwise.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_review"
            app:destination="@id/reviewTransactionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_addTransaction"
            app:destination="@id/addTransactionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_addLend"
            app:destination="@id/addLendFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_transactionHistory"
            app:destination="@id/transactionHistoryFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_lendHistory"
            app:destination="@id/lendHistoryFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/transactionHistoryFragment"
        android:name="com.tech.spendwise.TransactionHistoryFragment"
        android:label="Transaction History"
        tools:layout="@layout/fragment_transaction_history" />

    <fragment
        android:id="@+id/addLendFragment"
        android:name="com.tech.spendwise.AddLendFragment"
        android:label="Add Lend Amount"
        tools:layout="@layout/fragment_add_lend">
        <argument
            android:name="lendId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.tech.spendwise.AddTransactionFragment"
        android:label="Add Transaction"
        tools:layout="@layout/fragment_add_transaction">
        
        <deepLink
            android:id="@+id/deepLink_addTransaction"
            app:uri="spendwise://add_transaction" />
            
    </fragment>


    <fragment
        android:id="@+id/reviewTransactionFragment"
        android:name="com.tech.spendwise.ReviewTransactionFragment"
        android:label="Review Transaction"
        tools:layout="@layout/fragment_review_transaction" />

    <!-- ── Voice Input ──────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/voiceInputFragment"
        android:name="com.tech.spendwise.VoiceInputFragment"
        android:label="Voice Entry"
        tools:layout="@layout/fragment_voice_input">

        <!-- Whether to auto-start recognition (used by deep link / Assistant) -->
        <argument
            android:name="autoStart"
            app:argType="boolean"
            android:defaultValue="false" />

        <!-- Deep link: spendwise://voice?autoStart=true -->
        <deepLink
            android:id="@+id/deepLink_voiceEntry"
            app:uri="spendwise://voice" />

    </fragment>

    <!-- ── Voice Confirm ────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/lendHistoryFragment"
        android:name="com.tech.spendwise.LendHistoryFragment"
        android:label="Lend History"
        tools:layout="@layout/fragment_lend_history">
        <action
            android:id="@+id/action_history_to_addLend"
            app:destination="@id/addLendFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.tech.spendwise.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_settings_to_currency"
            app:destination="@id/currencyRegionFragment" />
        <action
            android:id="@+id/action_settings_to_appearance"
            app:destination="@id/appearanceFragment" />
        <action
            android:id="@+id/action_settings_to_language"
            app:destination="@id/languageFragment" />
        <action
            android:id="@+id/action_settings_to_bankSenders"
            app:destination="@id/bankSendersFragment" />
        <action
            android:id="@+id/action_settings_to_budgetAlerts"
            app:destination="@id/budgetAlertsFragment" />
        <action
            android:id="@+id/action_settings_to_backupRestore"
            app:destination="@id/backupRestoreFragment" />
        <action
            android:id="@+id/action_settings_to_securityLock"
            app:destination="@id/securityLockFragment" />
        <action
            android:id="@+id/action_settings_to_about"
            app:destination="@id/aboutFragment" />
    </fragment>

    <fragment
        android:id="@+id/currencyRegionFragment"
        android:name="com.tech.spendwise.CurrencyRegionFragment"
        android:label="Currency &amp; Region" />
    
    <fragment
        android:id="@+id/appearanceFragment"
        android:name="com.tech.spendwise.AppearanceFragment"
        android:label="Appearance" />

    <fragment
        android:id="@+id/languageFragment"
        android:name="com.tech.spendwise.LanguageFragment"
        android:label="Language" />

    <fragment
        android:id="@+id/bankSendersFragment"
        android:name="com.tech.spendwise.BankSendersFragment"
        android:label="Manage Bank Senders" />

    <fragment
        android:id="@+id/budgetAlertsFragment"
        android:name="com.tech.spendwise.BudgetAlertsFragment"
        android:label="Budget Alerts" />

    <fragment
        android:id="@+id/budgetDashboardFragment"
        android:name="com.tech.spendwise.BudgetDashboardFragment"
        android:label="Budget Dashboard"
        tools:layout="@layout/fragment_budget_dashboard" />

    <fragment
        android:id="@+id/backupRestoreFragment"
        android:name="com.tech.spendwise.BackupRestoreFragment"
        android:label="Backup &amp; Restore" />

    <fragment
        android:id="@+id/securityLockFragment"
        android:name="com.tech.spendwise.SecurityLockFragment"
        android:label="Security &amp; Lock" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.tech.spendwise.AboutFragment"
        android:label="About SpendWise" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.tech.spendwise.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_transactionHistory"
            app:destination="@id/transactionHistoryFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_profile_to_lendHistory"
            app:destination="@id/lendHistoryFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <!-- ── Splitwise ────────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/splitGroupsFragment"
        android:name="com.tech.spendwise.splitwise.SplitGroupsFragment"
        android:label="Split Expenses"
        tools:layout="@layout/fragment_split_groups">
        <action
            android:id="@+id/action_splitGroups_to_createGroup"
            app:destination="@id/createGroupFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_splitGroups_to_groupDetail"
            app:destination="@id/groupDetailFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/createGroupFragment"
        android:name="com.tech.spendwise.splitwise.CreateGroupFragment"
        android:label="Create Group"
        tools:layout="@layout/fragment_create_group" />

    <fragment
        android:id="@+id/groupDetailFragment"
        android:name="com.tech.spendwise.splitwise.GroupDetailFragment"
        android:label="Group Detail"
        tools:layout="@layout/fragment_group_detail">
        <argument
            android:name="groupId"
            app:argType="string" />
        <action
            android:id="@+id/action_groupDetail_to_addSplitExpense"
            app:destination="@id/addSplitExpenseFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/addSplitExpenseFragment"
        android:name="com.tech.spendwise.splitwise.AddSplitExpenseFragment"
        android:label="Add Expense"
        tools:layout="@layout/fragment_add_split_expense">
        <argument
            android:name="groupId"
            app:argType="string" />
        <argument
            android:name="expenseId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/joinGroupFragment"
        android:name="com.tech.spendwise.splitwise.JoinGroupFragment"
        android:label="Join Group">
        <argument
            android:name="id"
            app:argType="string" />
        <deepLink
            android:id="@+id/deepLink_joinGroup_custom"
            app:uri="spendwise://join?id={id}" />
        <deepLink
            android:id="@+id/deepLink_joinGroup_https"
            app:uri="https://shreyasdevang8545.github.io/SpendWise/join.html?id={id}" />
    </fragment>

    <!-- ── View Lend (Deep link from WhatsApp) ──────────────────────────── -->

    <fragment
        android:id="@+id/viewLendFragment"
        android:name="com.tech.spendwise.ViewLendFragment"
        android:label="Lend Details"
        tools:layout="@layout/fragment_view_lend">

        <deepLink
            android:id="@+id/deepLink_viewLend"
            app:uri="https://shreyasdevang8545.github.io/SpendWise/lend.html?name={name}&amp;phone={phone}&amp;amount={amount}&amp;date={date}&amp;returnLabel={returnLabel}&amp;lentOn={lentOn}&amp;mode={mode}&amp;note={note}&amp;status={status}" />

        <argument android:name="name"        app:argType="string" android:defaultValue="" />
        <argument android:name="phone"       app:argType="string" android:defaultValue="" />
        <argument android:name="amount"      app:argType="string" android:defaultValue="0" />
        <argument android:name="date"        app:argType="string" android:defaultValue="" />
        <argument android:name="returnLabel" app:argType="string" android:defaultValue="" />
        <argument android:name="lentOn"      app:argType="string" android:defaultValue="" />
        <argument android:name="mode"        app:argType="string" android:defaultValue="UPI" />
        <argument android:name="note"        app:argType="string" android:defaultValue="" />
        <argument android:name="status"      app:argType="string" android:defaultValue="pending" />
    </fragment>

</navigation>
