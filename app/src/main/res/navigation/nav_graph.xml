<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tech.spendwise.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_review"
            app:destination="@id/reviewTransactionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_voiceInput"
            app:destination="@id/voiceInputFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/reviewTransactionFragment"
        android:name="com.tech.spendwise.ReviewTransactionFragment"
        android:label="Review Transaction"
        tools:layout="@layout/fragment_review_transaction" />

    <!-- ── Voice Input ──────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/voiceInputFragment"
        android:name="com.tech.spendwise.VoiceInputFragment"
        android:label="Voice Entry"
        tools:layout="@layout/fragment_voice_input">

        <!-- Whether to auto-start recognition (used by deep link / Assistant) -->
        <argument
            android:name="autoStart"
            app:argType="boolean"
            android:defaultValue="false" />

        <!-- Deep link: spendwise://voice?autoStart=true -->
        <deepLink
            android:id="@+id/deepLink_voiceEntry"
            app:uri="spendwise://voice" />

        <action
            android:id="@+id/action_voiceInput_to_voiceConfirm"
            app:destination="@id/voiceConfirmFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <!-- ── Voice Confirm ────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/voiceConfirmFragment"
        android:name="com.tech.spendwise.VoiceConfirmFragment"
        android:label="Confirm Expense"
        tools:layout="@layout/fragment_voice_confirm">

        <argument
            android:name="parsedExpense"
            app:argType="com.tech.spendwise.ParsedExpense" />

        <argument
            android:name="transcript"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

</navigation>
