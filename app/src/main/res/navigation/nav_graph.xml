<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tech.spendwise.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_review"
            app:destination="@id/reviewTransactionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_addTransaction"
            app:destination="@id/addTransactionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_addLend"
            app:destination="@id/addLendFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_transactionHistory"
            app:destination="@id/transactionHistoryFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
        <action
            android:id="@+id/action_home_to_lendHistory"
            app:destination="@id/lendHistoryFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/transactionHistoryFragment"
        android:name="com.tech.spendwise.TransactionHistoryFragment"
        android:label="Transaction History"
        tools:layout="@layout/fragment_transaction_history" />

    <fragment
        android:id="@+id/addLendFragment"
        android:name="com.tech.spendwise.AddLendFragment"
        android:label="Add Lend Amount"
        tools:layout="@layout/fragment_add_lend">
        <argument
            android:name="lendId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.tech.spendwise.AddTransactionFragment"
        android:label="Add Transaction"
        tools:layout="@layout/fragment_add_transaction"/>


    <fragment
        android:id="@+id/reviewTransactionFragment"
        android:name="com.tech.spendwise.ReviewTransactionFragment"
        android:label="Review Transaction"
        tools:layout="@layout/fragment_review_transaction" />

    <!-- ── Voice Input ──────────────────────────────────────────────────── -->
    <fragment
        android:id="@+id/voiceInputFragment"
        android:name="com.tech.spendwise.VoiceInputFragment"
        android:label="Voice Entry"
        tools:layout="@layout/fragment_voice_input">

        <!-- Whether to auto-start recognition (used by deep link / Assistant) -->
        <argument
            android:name="autoStart"
            app:argType="boolean"
            android:defaultValue="false" />

        <!-- Deep link: spendwise://voice?autoStart=true -->
        <deepLink
            android:id="@+id/deepLink_voiceEntry"
            app:uri="spendwise://voice" />

    </fragment>

    <!-- ── Voice Confirm ────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/lendHistoryFragment"
        android:name="com.tech.spendwise.LendHistoryFragment"
        android:label="Lend History"
        tools:layout="@layout/fragment_lend_history">
        <action
            android:id="@+id/action_history_to_addLend"
            app:destination="@id/addLendFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

</navigation>
