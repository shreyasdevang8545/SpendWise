<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.SpendWise.AppBarLayout">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/settingsToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Widget.SpendWise.Toolbar"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/settings_title" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- GENERAL SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/section_general"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Premium -->
                    <include
                        android:id="@+id/itemPremium"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />

                    <!-- Profile & account -->
                    <include
                        android:id="@+id/itemProfile"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />


                    <!-- Language -->
                    <include
                        android:id="@+id/itemLanguage"
                        layout="@layout/layout_settings_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SMS & AUTO-DETECTION SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_sms"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/itemSmsAutoScan"
                        layout="@layout/layout_settings_row_toggle" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NOTIFICATIONS SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_notifications"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/itemTransactionAlerts"
                        layout="@layout/layout_settings_row_toggle" />


                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemMonthlySummary"
                        layout="@layout/layout_settings_row_toggle" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemMonthlyReport"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemDailyReminder"
                        layout="@layout/layout_settings_row_toggle" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DATA & PRIVACY SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_data_privacy"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/itemBackupRestore"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemSecurityLock"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemClearAllData"
                        layout="@layout/layout_settings_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SUPPORT SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_support"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/itemAbout"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemFeedback"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemPrivacyPolicy"
                        layout="@layout/layout_settings_row" />

                    <View style="@style/SettingsDivider" />

                    <include
                        android:id="@+id/itemRate"
                        layout="@layout/layout_settings_row" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
