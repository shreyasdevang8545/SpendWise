<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:padding="12dp">

    <!-- Header Branding -->
    <TextView
        android:id="@+id/widgetBranding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SpendWise"
        android:textColor="#4ADE80"
        android:textSize="10sp"
        android:textStyle="bold"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

    <!-- Current Month Label -->
    <TextView
        android:id="@+id/widgetMonthText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="April"
        android:textColor="#A0A0A0"
        android:textSize="10sp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true" />

    <!-- Main Content Cluster -->
    <LinearLayout
        android:id="@+id/mainDataCluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MONTHLY SPENT"
            android:textColor="#606060"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetSpentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Footer Summary Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <TextView
            android:id="@+id/widgetIncomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+₹0 Income"
            android:textColor="#4ADE80"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetBalanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0 Bal"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_gravity="end" />

    </LinearLayout>

</RelativeLayout>
