<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SpendWise" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/nunito_sans</item>
        <item name="fontFamily">@font/nunito_sans</item>
        
        <!-- Status & Nav Bar -->
        <item name="android:statusBarColor">@color/dark_header_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_light</item>

        <!-- Material 3 Overrides -->
        <item name="materialButtonStyle">@style/Widget.SpendWise.Button</item>
        <item name="chipStyle">@style/Widget.SpendWise.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.SpendWise.BottomNavigationView</item>

        <!-- Shape appearances -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SpendWise.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SpendWise.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SpendWise.Large</item>
    </style>

    <style name="Widget.SpendWise.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/Widget.SpendWise.BottomNav.Indicator</item>
    </style>

    <style name="Widget.SpendWise.BottomNav.Indicator" parent="" />

    <style name="Widget.SpendWise.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/nunito_sans</item>
    </style>

    <style name="ShapeAppearance.SpendWise.Button" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.SpendWise.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SpendWise.Button</item>
        <item name="strokeColor">@color/primary_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Theme.SpendWise" parent="Base.Theme.SpendWise" />

    <!-- ── Shape appearances ── -->
    <style name="ShapeAppearance.SpendWise.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.SpendWise.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.SpendWise.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <!-- ── Text appearances (Nunito Sans font) ── -->
    <style name="TextAppearance.SpendWise.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/nunito_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.SpendWise.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/nunito_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.SpendWise.Amount" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/nunito_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.SpendWise.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/nunito_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/nunito_sans</item>
    </style>
    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">72dp</item>
        <item name="android:background">#10FFFFFF</item>
    </style>

    <!-- Standardized Toolbars -->
    <style name="Widget.SpendWise.AppBarLayout" parent="Widget.MaterialComponents.AppBarLayout.Surface">
        <item name="android:background">@color/dark_header_green</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.SpendWise.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/dark_header_green</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="titleTextAppearance">@style/TextAppearance.SpendWise.Toolbar.Title</item>
    </style>

    <style name="TextAppearance.SpendWise.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <!-- Premium Chips -->
    <style name="Widget.SpendWise.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SpendWise.Chip</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="ShapeAppearance.SpendWise.Chip" parent="">
        <item name="cornerSize">10dp</item>
    </style>
</resources>